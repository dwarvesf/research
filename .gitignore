# to exclude Obsidian workspace settings (including plugin and hotkey configurations)
#.obsidian/
obsidian.zip

# OR only to exclude workspace cache
.obsidian/workspace
.obsidian/workspace.json

# exclude publish.json to avoid account conflicts
.obsidian/publish.json

# This file is used to keep track of last auto backup/pull
.obsidian-git-data

# Add below lines to exclude OS settings and caches
.trash/
.DS_Store

# dependencies
/node_modules

# IDE
.vscode
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# exclude history folder in local vscode
.history/*

# exclude _env file
_env.md

.obsidian/plugins/
